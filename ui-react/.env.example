# AetherTest React UI — Environment Variables
# Copy this file to .env and fill in your values.

# AWS Region where AetherTest resources are deployed
VITE_AWS_REGION=us-east-1

# AWS credentials with access to:
#   - DynamoDB tables: aethertest-agent-assignments, aethertest-executions
#   - S3 bucket: aethertest-artifacts-{accountId}
#   - Lambda function: aethertest-test-author-agent
VITE_AWS_ACCESS_KEY_ID=your-access-key-id
VITE_AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Required if using temporary credentials (SSO, assumed roles, etc.)
# Leave blank or remove if using long-lived IAM user keys.
VITE_AWS_SESSION_TOKEN=

# Local API server URL (for Requirements page — calls Python handlers locally)
# Run: python ui-react/api-server.py
VITE_API_BASE_URL=http://localhost:8000
