# Backend API URL
VITE_API_BASE=http://localhost:8001

# Default pipeline ARN for demo (pre-fills the input box)
VITE_DEFAULT_PIPELINE_ARN=arn:aws:states:us-east-1:<your-account-id>:stateMachine:KPI-Data-Pipeline

# ─── Backend (api-server.py) uses these env vars: ───
# AWS_PROFILE=aethertest          # SSO profile name (default: aethertest)
# AWS_DEFAULT_REGION=us-east-1    # AWS region
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# ATHENA_DATABASE=icebergtarget    # Athena/Glue database for Iceberg tables
# AETHERTEST_NO_SSL_VERIFY=1      # Set if behind corporate proxy
